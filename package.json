    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/logger": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/types": "^9.29.1",
    "appium": "^3.5.2",
    "appium-uiautomator2-driver": "^8.0.1",
    "eslint": "^9.39.4",
