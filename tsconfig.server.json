{
  "compilerOptions": {
    "module": "nodenext",
    "outDir": "./server/dist",
    "rootDir": "./server",
    "strict": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  }
}
