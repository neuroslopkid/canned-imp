{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@api": ["src/shared/api/index"],
      "@api/*": ["src/shared/api/*"],
      "@ui": ["src/shared/ui/index"],
      "@ui/*": ["src/shared/ui/*"],
      "@shared": ["src/shared/index"],
      "@shared/*": ["src/shared/*"],
      "@src/*": ["src/*"]
    }
  }
}
