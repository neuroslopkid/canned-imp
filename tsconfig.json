{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@api": ["./src/shared/api/index"],
      "@api/*": ["./src/shared/api/*"],
      "@components": ["./src/shared/ui/components/index"],
      "@components/*": ["./src/shared/ui/components/*"],
      "@constants": ["./src/shared/constants/index"],
      "@constants/*": ["./src/shared/constants/*"],
      "@context": ["./src/shared/context/index"],
      "@context/*": ["./src/shared/context/*"],
      "@helpers": ["./src/shared/helpers/index"],
      "@helpers/*": ["./src/shared/helpers/*"],
      "@typesInterfaces": ["./src/shared/typesInterfaces/index"],
      "@typesInterfaces/*": ["./src/shared/typesInterfaces/*"],
      "@redux": ["./src/shared/redux/index"],
      "@redux/*": ["./src/shared/redux/*"],
      "@ui": ["./src/shared/ui/index"],
      "@ui/*": ["./src/shared/ui/*"],
      "@utils": ["./src/shared/utils/index"],
      "@utils/*": ["./src/shared/utils/*"],
      "@shared": ["./src/shared/index"],
      "@shared/*": ["./src/shared/*"],
      "@src/*": ["./src/*"]
    },
    "types": ["jest", "node"]
  },
  "include": ["src", "App.tsx", "src/shared/typesInterfaces/declarations/svg.d.ts"],
  "exclude": []
}
